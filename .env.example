# Local frontend configuration (required to start Vite).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only credentials. Also configure these in the Trigger.dev worker
# environment: the deployed worker does not read this checkout's .env.
SUPABASE_SERVICE_ROLE_KEY=
POLLINATIONS_API_KEY=

# Required for PRO's queued generation and durable stream.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
