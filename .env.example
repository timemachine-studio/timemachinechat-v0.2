# ─── Client (VITE_ prefixed values are PUBLIC — compiled into the bundle) ───
# Never put a secret behind a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Feature flags
VITE_MAINTENANCE_MODE=false
VITE_ACCESS_TOKEN_REQUIRED=false
VITE_BETA_ACCESS_TOKEN=

# Display-only rate limits (real limits are enforced server-side)
VITE_DEFAULT_PERSONA_LIMIT=50
VITE_GIRLIE_PERSONA_LIMIT=70
VITE_PRO_PERSONA_LIMIT=50

# ─── Server-side only (never VITE_ prefixed) ───────────────────────────────
# AI providers — at least one required
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
POLLINATIONS_API_KEY=
EAON_API_KEY=
SECRETSTOAI_API_KEY=

# Supabase server key — bypasses RLS, treat as highly sensitive
SUPABASE_SERVICE_ROLE_KEY=

# CORS allowlist, comma-separated (see production-check.md 0.3).
# Production: ALLOWED_ORIGINS=https://timemachinechat.com,https://www.timemachinechat.com
# Add http://localhost:5173 in the dev environment only.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Abuse and spend controls (see production-check.md 0.4) ────────────────
# HMAC key for the anonymous-trial device cookie. Unset = IP-only trial
# counting, which is weaker. Use a long random value.
ANON_TRIAL_SECRET=

# Free messages an anonymous visitor gets, per 24h, on the default persona.
# Must match the number the UI advertises.
ANON_DEFAULT_PERSONA_LIMIT=3

# Hard daily ceiling on total generations per provider. 0 or unset disables it.
# This is the last line of defence for the card — set it.
PROVIDER_DAILY_CEILING=0
